# 依赖与构建产物（本项目无构建步骤，仅 node_modules）
node_modules/

# 测试/运行期产物
*.log
*.out
*.err
*.tmp-*
*.tmp
.git-*.tmp
.vmprobe-state/
.m0-state/
# 测试台的"远端根"（正常会被 stop() 删掉；异常中断时的残骸绝不入库 ——
# 里面有伪造的 authorized_keys 与备份，虽然只是公钥，但没有任何入库的理由）
.harness-remote-*/

# 本地凭据（**永不入库**；本项目本身也不应产生此类文件，这是防线而非惯例）
*.credentials.yaml
*.pem
*.key
# 发布脚本的临时凭据文件若被路径转义写歪，会落在工作区里 —— 再多一道防线
*git-credentials*
